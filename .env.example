# Copia este archivo a .env antes de levantar el stack.

# Credenciales del superusuario de Postgres. Vault las usa por detrás para crear y
# borrar los usuarios efímeros — no son las que usa el alumno para conectarse.
POSTGRES_USER=appadmin
POSTGRES_PASSWORD=appadmin

# No hay token de Vault que poner aquí: en este lab Vault arranca en modo real
# (sellado, sin inicializar), no en modo dev. El token root y las claves de desellado
# se generan la primera vez que se inicializa (apartado 2), no se fijan de antemano.
